{
  "name": "md-reader",
  "version": "1.0.0",
  "description": "DEHB Odaklı Modern Markdown Okuyucu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mdreader.app",
    "productName": "Markdown Okuyucu",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}